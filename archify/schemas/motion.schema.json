{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tt-a1i/archify/schemas/motion.schema.json",
  "title": "Archify Motion Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["motion_version", "diagram_type", "source", "beats", "assertions"],
  "properties": {
    "motion_version": { "const": "archify.motion.v1" },
    "diagram_type": { "enum": ["architecture", "workflow", "sequence", "dataflow", "lifecycle"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "diagramId": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "startMs", "durationMs", "primitive", "targets", "state"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "startMs": { "type": "integer", "minimum": 0 },
          "durationMs": { "type": "integer", "minimum": 1 },
          "primitive": { "enum": ["edge-pulse", "node-hold", "gate", "fanout", "converge", "retry", "callback", "reconcile"] },
          "targets": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nodes", "relationships"],
            "properties": {
              "nodes": { "type": "array", "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" }, "uniqueItems": true },
              "relationships": { "type": "array", "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" }, "uniqueItems": true }
            },
            "anyOf": [
              { "properties": { "nodes": { "type": "array", "minItems": 1 } } },
              { "properties": { "relationships": { "type": "array", "minItems": 1 } } }
            ]
          },
          "state": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$" },
          "caption": { "type": "string", "maxLength": 160 }
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "atMs", "activeBeats", "activeNodes", "activeRelationships", "states"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" },
          "atMs": { "type": "integer", "minimum": 0 },
          "activeBeats": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "activeNodes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "activeRelationships": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "states": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
